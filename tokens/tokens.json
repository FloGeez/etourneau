  "ease": {
    "$description": "Motion — easing curves",
    "out": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0.8,
        0.2,
        1
      ],
      "$description": "arrivals, moves"
    },
    "overshoot": {
      "$type": "cubicBezier",
      "$value": [
        0.3,
        1.6,
        0.5,
        1
      ],
      "$description": "wing raise, bounces"
    },
    "in-out": {
      "$type": "cubicBezier",
      "$value": [
        0.65,
        0,
        0.35,
        1
      ],
      "$description": "folds, back-and-forths"
    }
  }
